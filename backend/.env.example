# MongoDB Atlas Connection URI (or local MongoDB: mongodb://127.0.0.1:27017)
# For MongoDB Atlas, format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=skillswap_db

# Legacy MySQL Settings (Used by migration script to import data from MySQL)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=skillswap_db
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=

# Security & JWT Authentication
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_TOKEN_EXPIRES_SECONDS=3600

# Comma-separated development frontend origins
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=true

# Email verification
OTP_HASH_SECRET=replace-with-a-separate-random-secret-of-at-least-32-characters
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=5
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Live classroom
SESSION_TIMEZONE=Asia/Kolkata
SESSION_END_GRACE_MINUTES=15
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
SOCKETIO_MESSAGE_QUEUE=
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600

# Private or managed Judge0-compatible sandbox. Keep credentials backend-only.
CODE_EXECUTION_API_URL=
CODE_EXECUTION_API_KEY=
CODE_EXECUTION_API_KEY_HEADER=X-Auth-Token
CODE_EXECUTION_MAX_SOURCE_BYTES=50000
CODE_EXECUTION_MAX_STDIN_BYTES=5000
